# Copy to .env and fill in. .env is git-ignored.

# ---- Secrets ----
INFLUX_TOKEN=change-me-influx-admin-token
APP_ENCRYPTION_KEY=change-me-32-byte-key            # AES-256-GCM key for secrets at rest
APP_API_TOKEN=change-me-bearer-token                # static bearer for headless automation (browsers use cookie sessions)
APP_ADMIN_PASSWORD=change-me-admin-password         # seeds bootstrap Superadmin 'admin' on empty DB (Phase 8); forced change on first login

# ---- Netbox: first-boot seed only; runtime source of truth is the settings table ----
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=change-me-netbox-token

# ---- Tunables (optional; have defaults) ----
PING_INTERVAL_SECONDS=20
DISCOVERY_CONCURRENCY=32
